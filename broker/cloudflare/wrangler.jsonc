{
  "name": "rayneo-token-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "TOKEN_BROKER",
        "class_name": "TokenBrokerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TokenBrokerDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
  // Configure BROKER_SECRET as a Cloudflare Worker Secret (NEVER put it in "vars"):
  //   npx wrangler secret put BROKER_SECRET
}
