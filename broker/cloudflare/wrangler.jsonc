{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rayneo-token-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "TOKEN_BROKER",
        "class_name": "TokenBrokerDO"
      }
    ]
  },
  "exports": {
    "TokenBrokerDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "BROKER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
